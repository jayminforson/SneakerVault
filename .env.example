# Copy this file to .env.local and fill in the values.
# Every variable below is read by the app; the ones marked REQUIRED must be set
# or the feature they back will fail at runtime.

# ─── Admin ────────────────────────────────────────────────────────────────────
# Password for the /admin login. REQUIRED — this signs the admin session cookie.
# Use a long random string, e.g. `openssl rand -hex 24`.
ADMIN_PASSWORD=

# ─── Payments (Paystack) ──────────────────────────────────────────────────────
# Secret key from https://dashboard.paystack.com/#/settings/developers
# Use the test key (sk_test_...) while developing. REQUIRED for checkout.
PAYSTACK_SECRET_KEY=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# API key from https://resend.com/api-keys. REQUIRED for receipts/notifications.
RESEND_API_KEY=

# "From" address. Must be a domain verified in Resend (e.g. receipts@yourdomain.com).
FROM_EMAIL=SneakerVault <receipts@example.com>

# Where new-order alerts go. REQUIRED for the owner notification email.
OWNER_EMAIL=

# ─── Database (Neon Postgres) ─────────────────────────────────────────────────
# Connection string from the Neon console. REQUIRED — products and orders live here.
# Grab the non-pooled (direct) connection string. Do NOT use the -pooler
# endpoint: this app talks HTTP via @neondatabase/serverless and never holds a
# session open, so pgBouncer would only add latency.
# e.g. postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ─── File storage (Vercel Blob) ───────────────────────────────────────────────
# Credentials for the Vercel Blob store. REQUIRED for admin image uploads.
# Vercel adds BLOB_READ_WRITE_TOKEN when you create a store, and BLOB_STORE_ID
# when you connect one. Either satisfies the app: on Vercel OIDC (BLOB_STORE_ID)
# wins, but outside Vercel you need the read-write token.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
